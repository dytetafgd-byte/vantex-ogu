<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin — ogu</title>
  <link rel="stylesheet" href="/ogu.css">
  <style>:root{<%= themeVars %>}</style>
</head>
<body data-theme="<%= theme %>">
  
  

  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/">ogu</a>
      <span class="spacer"></span>
      <a href="/settings">settings</a>
      <% if (user) { %><a href="/u/<%= user.username %>"><%= user.username %></a><% } %>
    </header>

    <div class="err" id="err"></div>

    <section class="panel">
      <h2 style="margin-top:0">Accounts</h2>
      <table>
        <thead><tr><th>Username</th><th>Credits</th><th>State</th><th>Actions</th></tr></thead>
        <tbody id="users"></tbody>
      </table>
    </section>

    <section class="panel">
      <h3 style="margin-top:0">Custom badge</h3>
      <p class="muted">Label is 1–20 characters. The emoji is what shows next to a name.</p>
      <div class="row">
        <input id="bLabel" maxlength="20" placeholder="Spooky" style="max-width:180px">
        <input id="bEmoji" maxlength="4" placeholder="🎃" style="max-width:80px">
        <input id="bPrice" type="number" min="0" placeholder="Price" style="max-width:120px">
        <button class="primary" id="bCreate">Create badge</button>
      </div>
    </section>

    <section class="panel">
      <h3 style="margin-top:0">Give / remove a badge</h3>
      <div class="row">
        <input id="gUser" placeholder="username" style="max-width:160px">
        <select id="gBadge" style="max-width:220px"></select>
        <button class="primary" id="gGrant">Give</button>
        <button id="gRevoke">Remove</button>
      </div>
    </section>

    <section class="panel">
      <h3 style="margin-top:0">IP bans</h3>
      <div class="row">
        <input id="ip" placeholder="1.2.3.4" style="max-width:200px">
        <input id="ipReason" placeholder="reason" style="flex:1;min-width:160px">
        <button class="primary" id="ipBan">Ban IP</button>
        <button id="ipUnban">Unban IP</button>
      </div>
      <table style="margin-top:12px">
        <thead><tr><th>IP</th><th>Reason</th><th></th></tr></thead>
        <tbody id="bans"></tbody>
      </table>
    </section>

    <section class="panel">
      <h3 style="margin-top:0">Recent actions</h3>
      <table>
        <thead><tr><th>Admin</th><th>Action</th><th>Target</th><th>When</th></tr></thead>
        <tbody id="log"></tbody>
      </table>
    </section>
  </div>

  <script>
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    async function call(path, body) {
      const err = document.getElementById('err');
      err.textContent = '';
      const res = await fetch(path, {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body || {}),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { err.textContent = data.error || 'That did not work.'; return null; }
      load();
      return data;
    }

    async function load() {
      const res = await fetch('/api/admin');
      if (!res.ok) {
        document.getElementById('err').textContent = 'This page is for x only.';
        return;
      }
      const d = await res.json();

      document.getElementById('users').innerHTML = d.users.map(u => `
        <tr>
          <td>${esc(u.username)} ${u.is_admin ? '<span class="muted">(x)</span>' : ''}</td>
          <td>${u.credits}</td>
          <td class="muted">${u.banned ? 'banned' : ''}${u.muted_until > Date.now() ? ' muted' : ''}</td>
          <td>
            <button data-act="credits" data-id="${u.id}" data-delta="100">+100</button>
            <button data-act="credits" data-id="${u.id}" data-delta="-100">−100</button>
            <button data-act="timeout" data-id="${u.id}" data-min="30">timeout 30m</button>
            <button data-act="untimeout" data-id="${u.id}">clear timeout</button>
            <button data-act="ban" data-id="${u.id}">ban</button>
            <button data-act="unban" data-id="${u.id}">unban</button>
            <button data-act="delete" data-id="${u.id}">delete</button>
          </td>
        </tr>`).join('');

      document.querySelectorAll('#users button').forEach(b => b.addEventListener('click', async () => {
        const id = Number(b.dataset.id);
        switch (b.dataset.act) {
          case 'credits':
            return call('/api/admin/credits', { userId: id, delta: Number(b.dataset.delta) });
          case 'timeout':
            return call('/api/admin/user/timeout', { userId: id, minutes: Number(b.dataset.min) });
          case 'untimeout':
            return call('/api/admin/user/untimeout', { userId: id });
          case 'ban':
            return call('/api/admin/user/ban', { userId: id });
          case 'unban':
            return call('/api/admin/user/unban', { userId: id });
          case 'delete':
            if (confirm('Delete this account?')) return call('/api/admin/user/delete', { userId: id });
        }
      }));

      document.getElementById('bans').innerHTML = d.bans.map(b => `
        <tr>
          <td>${esc(b.ip)}</td>
          <td class="muted">${esc(b.reason || '')}</td>
          <td><button data-unban="${esc(b.ip)}">unban</button></td>
        </tr>`).join('') || '<tr><td colspan="3" class="muted">No IP bans.</td></tr>';

      document.querySelectorAll('#bans button[data-unban]').forEach(b =>
        b.addEventListener('click', () => call('/api/admin/ip/unban', { ip: b.dataset.unban })));

      document.getElementById('log').innerHTML = d.log.map(l => `
        <tr>
          <td>${esc(l.admin || '')}</td>
          <td>${esc(l.action)}</td>
          <td class="muted">${esc(l.target || '')}</td>
          <td class="muted">${new Date(l.created_at).toLocaleString()}</td>
        </tr>`).join('');
    }

    fetch('/api/badges').then(r => r.json()).then(d => {
      document.getElementById('gBadge').innerHTML = d.badges.map(b =>
        `<option value="${b.id}">${b.emoji} ${esc(b.label)}</option>`).join('');
    });

    document.getElementById('bCreate').addEventListener('click', () => call('/api/admin/badges/create', {
      label: document.getElementById('bLabel').value,
      emoji: document.getElementById('bEmoji').value,
      price: Number(document.getElementById('bPrice').value) || 750,
    }));

    document.getElementById('gGrant').addEventListener('click', () => call('/api/admin/badges/grant', {
      username: document.getElementById('gUser').value.trim(),
      badgeId: Number(document.getElementById('gBadge').value),
    }));

    document.getElementById('gRevoke').addEventListener('click', async () => {
      // resolve the username to an id first, since revoke works by id
      const name = document.getElementById('gUser').value.trim();
      const res = await fetch('/api/profile/' + encodeURIComponent(name));
      if (!res.ok) { document.getElementById('err').textContent = 'No such user.'; return; }
      const { user } = await res.json();
      call('/api/admin/badges/revoke', {
        userId: user.id, badgeId: Number(document.getElementById('gBadge').value),
      });
    });

    document.getElementById('ipBan').addEventListener('click', () => call('/api/admin/ip/ban', {
      ip: document.getElementById('ip').value.trim(),
      reason: document.getElementById('ipReason').value.trim(),
    }));
    document.getElementById('ipUnban').addEventListener('click', () =>
      call('/api/admin/ip/unban', { ip: document.getElementById('ip').value.trim() }));

    load();
  </script>
</body>
</html>