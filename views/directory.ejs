<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Directory — ogu</title>
  <link rel="stylesheet" href="/ogu.css">
  <style>:root{<%= themeVars %>}</style>
</head>
<body data-theme="<%= theme %>">
  
  
  

  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/">ogu</a>
      <a href="/directory">directory</a>
      <a href="/leaderboard">leaderboard</a>
      <span class="spacer"></span>
      <% if (user) { %>
        <a href="/u/<%= user.username %>"><%= user.username %></a>
        <span class="muted"><%= user.credits %> credits</span>
        <a href="/settings">settings</a>
      <% } else { %>
        <a class="btn" href="/login">log in</a>
      <% } %>
    </header>

    <section class="panel">
      <h2 style="margin-top:0">Directory</h2>
      <div class="row">
        <input id="q" placeholder="Search usernames…" style="flex:1;min-width:220px">
        <button class="primary" id="go">Search</button>
      </div>
    </section>

    <div class="grid" id="results"></div>

    <section class="panel">
      <h3 style="margin-top:0">Listed for sale</h3>
      <p class="muted">Prices are in USD. Listing a name opens a ticket rather than selling it here.</p>
      <table>
        <thead><tr><th>Username</th><th>Price</th><th>Note</th><th></th></tr></thead>
        <tbody id="listings"></tbody>
      </table>
    </section>

    <% if (user) { %>
    <section class="panel">
      <h3 style="margin-top:0">List one of your names</h3>
      <div class="row">
        <input id="price" type="number" min="0" step="1" placeholder="Price in USD" style="max-width:180px">
        <input id="note" placeholder="Optional note" style="flex:1;min-width:180px">
        <button class="primary" id="list">List it</button>
      </div>
      <div class="err" id="err"></div>
    </section>
    <% } %>
  </div>

  <script src="/app.js"></script>
  <script>
    async function load() {
      const q = document.getElementById('q').value;
      const res = await fetch('/api/directory?q=' + encodeURIComponent(q));
      const data = await res.json();

      document.getElementById('results').innerHTML = data.users.map(u => `
        <a class="panel" href="/u/${encodeURIComponent(u.username)}" style="display:block">
          <div class="row" style="gap:10px">
            <div class="avatar" style="width:40px;height:40px;font-size:16px">
              ${u.avatar ? `<img src="${u.avatar}" alt="" style="width:100%;height:100%;border-radius:50%">` : u.username[0].toUpperCase()}
            </div>
            <div>
              <div class="name-line">
                <strong>${u.username}</strong>
                ${u.is_founder ? '<span class="check">✔</span>' : ''}
              </div>
              <div class="muted">${u.badge_count} badges${u.price != null ? ` · $${Number(u.price).toFixed(2)}` : ''}</div>
            </div>
          </div>
        </a>`).join('') || '<p class="muted">Nothing matched.</p>';

      document.getElementById('listings').innerHTML = data.listings.map(l => `
        <tr>
          <td><a href="/u/${encodeURIComponent(l.username)}">${l.username}</a></td>
          <td>$${Number(l.price_usd).toFixed(2)}</td>
          <td class="muted">${l.note || ''}</td>
          <td></td>
        </tr>`).join('') || '<tr><td colspan="4" class="muted">No active listings.</td></tr>';
    }

    document.getElementById('go').addEventListener('click', load);
    document.getElementById('q').addEventListener('keydown', e => { if (e.key === 'Enter') load(); });
    document.getElementById('list')?.addEventListener('click', async () => {
      const err = document.getElementById('err');
      err.textContent = '';
      const res = await fetch('/api/listings', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          price: document.getElementById('price').value,
          note: document.getElementById('note').value,
        }),
      });
      const data = await res.json();
      if (!res.ok) { err.textContent = data.error || 'Could not list.'; return; }
      load();
    });
    load();
  </script>
</body>
</html>